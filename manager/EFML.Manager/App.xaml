<Application
    x:Class="EFML.Manager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Endfield palette instead of the system accent: dark theme draws accents with the
                 Light shades (yellow, black text), light theme with the Dark shades (black, white text). -->
            <Color x:Key="SystemAccentColor">#FFFFD400</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFFDB33</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFFD400</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFE466</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1A1A1A</Color>
            <Color x:Key="SystemAccentColorDark2">#FF111111</Color>
            <Color x:Key="SystemAccentColorDark3">#FF000000</Color>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EfmlAccentBrush" Color="#FFE0B800" />
                    <SolidColorBrush x:Key="EfmlOkBrush" Color="#FF2E7D32" />
                    <SolidColorBrush x:Key="EfmlWarnBrush" Color="#FFB26A00" />
                    <SolidColorBrush x:Key="EfmlErrorBrush" Color="#FFC62828" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="EfmlAccentBrush" Color="#FFFFD400" />
                    <SolidColorBrush x:Key="EfmlOkBrush" Color="#FF6CCB5F" />
                    <SolidColorBrush x:Key="EfmlWarnBrush" Color="#FFFFB547" />
                    <SolidColorBrush x:Key="EfmlErrorBrush" Color="#FFFF6B6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="EfmlAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="EfmlOkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EfmlWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EfmlErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
